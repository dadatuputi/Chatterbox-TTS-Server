# Copy to .env and fill in.  ->  cp .env.example .env
# Never commit the real .env.

# --- Domains -------------------------------------------------------------
# Both must be DNS names that resolve to THIS host. COOKIE_DOMAIN must be a
# parent of both (so the Authelia session cookie is valid across them).
# Keep these in sync with authelia/configuration.yml (it hardcodes the same names).
APP_DOMAIN=tts.example.com
AUTH_DOMAIN=auth.example.com
COOKIE_DOMAIN=example.com

# Email used for Let's Encrypt/ZeroSSL certificate registration (Caddy).
# Leave blank to let Caddy pick a default. For internal-only TLS see the README.
ACME_EMAIL=

# --- TTS app -------------------------------------------------------------
# Which Dockerfile to build the app from — match your GPU:
#   Dockerfile          NVIDIA CUDA 12.1  (RTX 20/30/40)
#   Dockerfile.cu128    NVIDIA CUDA 12.8  (RTX 50 / Blackwell)
#   Dockerfile.cu130    NVIDIA CUDA 13.0  (DGX Spark)
#   Dockerfile.rocm     AMD ROCm
#   Dockerfile.cpu      CPU only
APP_DOCKERFILE=Dockerfile

# Optional Hugging Face token (for gated model downloads).
HF_TOKEN=

# --- Machine API (/v1/audio/*) ------------------------------------------
# Bearer token for scripts / Open WebUI. Generate a strong one:
#   openssl rand -base64 36
API_TOKEN=change-me-to-a-long-random-token

# --- Authelia secrets ----------------------------------------------------
# Generate EACH of these independently:  openssl rand -base64 64
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me
AUTHELIA_JWT_SECRET=change-me
