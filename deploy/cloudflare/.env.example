# Copy to .env and fill in.  ->  cp .env.example .env
# Never commit the real .env.

# --- Cloudflare Tunnel ---------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel (cloudflared)
# -> copy the tunnel TOKEN (a long "eyJ..."-style string) and paste it here.
# The token encodes the tunnel's credentials; no cert/credentials file needed.
TUNNEL_TOKEN=

# The public hostname you routed to this tunnel (used only by the test script).
APP_HOSTNAME=chatter.example.com

# --- TTS app -------------------------------------------------------------
# Which Dockerfile to build from — match your GPU:
#   Dockerfile (cu121, RTX 20/30/40) | Dockerfile.cu128 (RTX 50) |
#   Dockerfile.cu130 | Dockerfile.rocm | Dockerfile.cpu
APP_DOCKERFILE=Dockerfile

# Optional Hugging Face token (gated model downloads).
HF_TOKEN=

# --- Optional: API access via a Cloudflare Access service token ----------
# Only needed to run the API smoke test (scripts/Open WebUI hitting /v1/*).
# Zero Trust -> Access -> Service Auth -> create a service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
